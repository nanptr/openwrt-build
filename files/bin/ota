#!/bin/sh

if [ -f /lib/upgrade/ota.sh ]; then
    . /lib/upgrade/ota.sh
    export_ota_url
fi

if [ -z "$OTA_URL_BASE" ]; then
    echo "Unsupported device." >&2
    exit 255
fi

WRLOCK=/var/lock/ota_background.lock
STLOCK=/var/lock/ota_status.lock

action="${1}"
shift

sha256() {
    sha256sum "$1" | cut -d' ' -f1
}

fcurl() {
    curl -L --fail --show-error "$@"
}

download() {
    local img="$1"
    local sum="$2"
    local pid url

    exec 300>"$STLOCK"
    flock 300
    touch /tmp/firmware.img.part
    : >/tmp/firmware.img.progress
    rm -f /tmp/firmware.img.sha256sum
    flock -u 300

    if [ -f /tmp/firmware.img ]; then
        echo "Checking existed firmware.img..." >> /tmp/firmware.img.progress
        if [ "$(sha256 /tmp/firmware.img)" = "$sum" ]; then
            flock 300
            echo "$sum" > /tmp/firmware.img.sha256sum
            rm -f /tmp/firmware.img.part /tmp/firmware.img.progress
            flock -u 300
            return 0
        fi

        echo "Check failed, redownload" >> /tmp/firmware.img.progress
        rm -f /tmp/firmware.img
    fi

    url="$OTA_URL_BASE/$img"
    echo "Try $url" >> /tmp/firmware.img.progress
    flock 300
    echo "#=#=#" >> /tmp/firmware.img.progress
    fcurl --connect-timeout 10 --progress-bar -o /tmp/firmware.img.part "$url" 2>>/tmp/firmware.img.progress &
    pid="$!"
    echo "$pid" > /var/run/ota/download.pid
    flock -u 300

    if wait "$pid"; then
        rm -f /var/run/ota/download.pid
        echo "Checking new firmware.img.part..." > /tmp/firmware.img.progress
        if [ "$(sha256 /tmp/firmware.img.part)" = "$sum" ]; then
            flock 300
            mv /tmp/firmware.img.part /tmp/firmware.img
            echo "$sum" > /tmp/firmware.img.sha256sum
            rm -f /tmp/firmware.img.progress
            flock -u 300
            return 0
        fi

        echo "Checksum failed!" >> /tmp/firmware.img.progress
    else
        echo >> /tmp/firmware.img.progress
        if [ $? -eq 143 ]; then
            echo "Canceled!" >> /tmp/firmware.img.progress
        fi
    fi

    rm -f /var/run/ota/download.pid /tmp/firmware.img.part
    return 1
}

lock_download() {
    exec 200>"$WRLOCK"
    flock -n 200 || return
    download "$1" "$2"
    flock -u 200
}

prepare_check() {
    local line
    local release revision current latest more_url

    release="$(grep "DISTRIB_RELEASE=" /etc/openwrt_release | sed -E "s/.*'(.+)'.*/\1/")"
    revision="$(grep "DISTRIB_REVISION=" /etc/openwrt_release | sed -E "s/.*'(.+)'.*/\1/" | cut -d'-' -f1)"
    current="$release-$revision"
    latest=0
    more_url="${OTA_RELEASES_URL:-$OTA_URL_BASE}"

    : >/var/run/ota/ota.log
    fcurl --connect-timeout 10 -o /var/run/ota/ota.latest "$OTA_URL_BASE/version.latest" || {
        rm -f /var/run/ota/ota.latest
        return 255
    }

    if head -1 /var/run/ota/ota.latest | grep -Fq "$current"; then
        latest=1
        current=""
    fi

    fcurl --connect-timeout 10 -o /var/run/ota/ota.index "$OTA_URL_BASE/version.index" || return 255

    head -5 /var/run/ota/ota.index | while read -r line; do
        if [ -z "$line" ] || [ "$line" = "$current" ]; then
            break
        fi
        echo "<h3>${line}</h3><pre>" >> /var/run/ota/ota.log
        fcurl --connect-timeout 10 "$OTA_URL_BASE/${line}.log" >> /var/run/ota/ota.log 2>/dev/null
        echo "</pre>" >> /var/run/ota/ota.log
    done

    [ "$(wc -l < /var/run/ota/ota.log)" -eq 0 ] && return 1
    echo "<a href=\"$more_url\" onclick=\"void(0)\" target=\"_blank\">Releases</a>" >> /var/run/ota/ota.log
    fcurl --connect-timeout 5 "$OTA_URL_BASE/ota.footer.html" >> /var/run/ota/ota.log 2>/dev/null || true
    return "$latest"
}

do_check() {
    local ret=0

    exec 200>"$WRLOCK"
    if flock -n 200; then
        prepare_check
        ret=$?
        flock -u 200 >/dev/null 2>&1
    elif [ -f /tmp/firmware.img.progress ] || [ -f /tmp/firmware.img.sha256sum ]; then
        ret=2
    else
        echo "lock failed!" >&2
        return 255
    fi

    if [ "$ret" -eq 0 ] || [ "$ret" -eq 2 ]; then
        echo "<pre>"
        sed -E '1 s/^\[.*\]\((.+)\)\s*$/\1/' /var/run/ota/ota.latest
        echo "</pre>"
        echo "<br><h2>ChangeLog:</h2>"
    fi

    if [ "$ret" -eq 0 ] || [ "$ret" -eq 1 ] || [ "$ret" -eq 2 ]; then
        cat /var/run/ota/ota.log
    fi

    return "$ret"
}

do_download() {
    local img sum

    img="$(head -1 /var/run/ota/ota.latest | sed -E 's/.*\((.+)\).*/\1/')"
    sum="$(head -3 /var/run/ota/ota.latest | grep '^SHA256: ' | cut -d' ' -f2)"
    [ -z "$img" ] || [ -z "$sum" ] && {
        echo "do check first" >&2
        return 254
    }

    lock_download "$img" "$sum" &
    return 0
}

do_progress() {
    local sum

    sum="$(head -3 /var/run/ota/ota.latest | grep '^SHA256: ' | cut -d' ' -f2)"
    [ -z "$sum" ] && {
        echo "do check first" >&2
        return 254
    }
    [ -f /tmp/firmware.img.sha256sum ] && [ "$(cat /tmp/firmware.img.sha256sum)" = "$sum" ] && return 0
    [ -f /tmp/firmware.img.progress ] || {
        echo "download not in progress" >&2
        return 254
    }
    [ -f /tmp/firmware.img.part ] && {
        tr '\r' '\n' < /tmp/firmware.img.progress | tail -n1
        return 1
    }
    tail -1 /tmp/firmware.img.progress | grep -Fq 'Canceled!' && {
        echo "Canceled"
        return 2
    }
    tr '\r' '\n' < /tmp/firmware.img.progress | grep -v '^$' | tail -n1 >&2
    return 3
}

do_progress_locked() {
    local ret

    exec 300>"$STLOCK"
    flock -s 300
    do_progress
    ret=$?
    flock -u 300
    return "$ret"
}

do_cancel() {
    local pid

    if [ -f /var/run/ota/download.pid ]; then
        pid="$(cat /var/run/ota/download.pid)"
        if [ -n "$pid" ]; then
            kill -TERM "$pid"
            while kill -0 "$pid" >/dev/null 2>&1; do
                sleep 1 || break
            done
        fi
    fi

    return 0
}

ota_init() {
    mkdir -p /var/run/ota >/dev/null 2>&1 || true
}

usage() {
    echo "usage: ota sub-command"
    echo "where sub-command is one of:"
    echo "      check                  Check firmware upgrade"
    echo "      download               Download latest firmware"
    echo "      progress               Download progress"
    echo "      cancel                 Cancel download"
}

ota_init || exit 255

case "$action" in
    check)
        do_check
    ;;
    download)
        do_download
    ;;
    progress)
        do_progress_locked
    ;;
    cancel)
        do_cancel
    ;;
    *)
        usage
    ;;
esac
