#!/bin/sh

uci -q batch <<'EOF'
set network.lan.ipaddr='192.168.10.1/24'

set ttyd.@ttyd[0].interface='127.0.0.1'
set ttyd.@ttyd[0].port='7681'
set ttyd.@ttyd[0].url_override='/ttyd/'
set ttyd.@ttyd[0].check_origin='1'

delete firewall.zerotier
set firewall.zerotier=zone
set firewall.zerotier.name='zerotier'
add_list firewall.zerotier.device='ztyous6nse'
set firewall.zerotier.input='ACCEPT'
set firewall.zerotier.output='ACCEPT'
set firewall.zerotier.forward='ACCEPT'

delete firewall.lan_to_zerotier
set firewall.lan_to_zerotier=forwarding
set firewall.lan_to_zerotier.src='lan'
set firewall.lan_to_zerotier.dest='zerotier'

delete firewall.zerotier_to_lan
set firewall.zerotier_to_lan=forwarding
set firewall.zerotier_to_lan.src='zerotier'
set firewall.zerotier_to_lan.dest='lan'

commit network
commit firewall
commit ttyd
EOF

# OTA 下载走本机代理（凭据在 /etc/ota-proxy.conf，不进公开仓库）
if [ -f /etc/ota-proxy.conf ] && ! grep -q OTA_PROXY_INJECTED /bin/ota 2>/dev/null; then
	sed -i '2i [ -f /etc/ota-proxy.conf ] && . /etc/ota-proxy.conf # OTA_PROXY_INJECTED' /bin/ota
fi

# nikki 冷启动缓存跨 sysupgrade 保留；sysupgrade.conf 自引用，防止清单自身被重置
for p in /etc/nikki-cache /etc/ota-proxy.conf /etc/sysupgrade.conf; do
	grep -qx "$p" /etc/sysupgrade.conf 2>/dev/null || echo "$p" >> /etc/sysupgrade.conf
done

exit 0
